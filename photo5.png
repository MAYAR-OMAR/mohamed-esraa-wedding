    .chatgptChatView.cc440d50ba-split-enabled .cc440d50ba-express-entrypoint-button:hover .cc440d50ba-express-entrypoint-button-icon-img--hover,
    .chatgptChatView.cc440d50ba-split-enabled .cc440d50ba-express-entrypoint-button.cc440d50ba-dropdown-hover .cc440d50ba-express-entrypoint-button-icon-img--hover {
      display: inline-block;
    }

    /* Outlook Native Viewer styles */
    .outlookNativeViewer .cc440d50ba-express-entrypoint-button {
      background-color: transparent;
      border: 1px solid transparent;
      border-radius: 2px;
      height: 32px;
      padding: 6px 4px 6px 0px;
    }

    .outlookNativeViewer .cc440d50ba-express-entrypoint-button:hover {
      background-color: rgba(0, 0, 0, 0.05);
    }

    .outlookNativeViewer .cc440d50ba-express-entrypoint-button .cc440d50ba-express-entrypoint-button-icon {
      width: 32px;
      height: 32px;
      padding: 6px;
